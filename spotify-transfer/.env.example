# Put your Spotify API credentials here
# Do NOT share this file or commit it to GitHub (it's ignored by .gitignore)

SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here

# When hosting on a real website (like Render or Heroku), change this to your actual website URL (e.g. https://my-spotify-app.onrender.com/callback)
# Keep it as localhost for local testing
SPOTIPY_REDIRECT_URI=http://localhost:5000/callback

# A random string used to secure browser sessions (only strictly needed for production hosting)
FLASK_SECRET_KEY=change_me_to_a_random_secure_string_for_production
